{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.inmonest.com" }],
      "destination": "https://inmonest.com/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "src/app/api/gestoria/checkout/route.ts": { "maxDuration": 30 },
    "src/app/api/stripe/checkout/route.ts": { "maxDuration": 30 }
  },
  "rewrites": [],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=21600, stale-while-revalidate=43200" },
        { "key": "X-Robots-Tag", "value": "noai, noimageai" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" },
        { "key": "X-Robots-Tag", "value": "noai, noimageai" }
      ]
    },
    {
      "source": "/(gestoria|vender-casa|agencias|contacto|seguridad|blog|servicios|opiniones|hipoteca|calculadora-gastos-compra|calculadora-gastos-alquiler|calculadora-ahorro-comisiones|vender-piso-sin-agencia|sobre-nosotros|contratos-inmobiliarios)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=86400, stale-while-revalidate=604800" },
        { "key": "X-Robots-Tag", "value": "noai, noimageai" }
      ]
    },
    {
      "source": "/barcelona/contrato-(arras|alquiler)/:barrio",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=86400, stale-while-revalidate=604800" },
        { "key": "X-Robots-Tag", "value": "noai, noimageai" }
      ]
    },
    {
      "source": "/:ciudad/(alquiler-particulares|alquiler-sin-agencia|contrato-alquiler|contrato-arras|vender-piso|pisos|alquiler-temporada|pisos-particulares-sin-comision)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=86400, stale-while-revalidate=604800" },
        { "key": "X-Robots-Tag", "value": "noai, noimageai" }
      ]
    },
    {
      "source": "/video/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=604800, immutable" }
      ]
    }
  ],
  "crons": []
}

